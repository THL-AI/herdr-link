{
  // The published JavaScript: src/ compiled to dist/ (imports rewritten from .ts to .js),
  // so installs need neither tsx nor esbuild. `pnpm build`; npm runs it before packing.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src"],
  "exclude": ["src/schema.ts"]
}
