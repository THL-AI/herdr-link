{
  "name": "@thl-ai/herdr-link",
  "version": "0.6.0",
  "description": "Steer the coding agents running in herdr from Discord, Telegram or any chat app, through adapters",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/THL-AI/herdr-link.git"
  },
  "homepage": "https://thl-ai.github.io/herdr-link/",
  "bugs": "https://github.com/THL-AI/herdr-link/issues",
  "keywords": [
    "herdr",
    "discord",
    "claude-code",
    "grok",
    "telegram",
    "coding-agents",
    "effect"
  ],
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "herdr-link": "bin/herdr-link.mjs",
    "herdr-link-discord": "bin/herdr-link-discord.mjs",
    "herdr-link-telegram": "bin/herdr-link-telegram.mjs"
  },
  "files": [
    "bin",
    "src",
    "!src/schema.ts",
    "hooks",
    "mod",
    "schema",
    "config.example.toml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/cli/main.ts run",
    "start": "node bin/herdr-link.mjs run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema": "tsx src/schema.ts > schema/chat.openrpc.json",
    "hooks:install": "node bin/herdr-link.mjs hooks install",
    "hooks:uninstall": "node bin/herdr-link.mjs hooks uninstall",
    "service:install": "node bin/herdr-link.mjs service install",
    "service:uninstall": "node bin/herdr-link.mjs service uninstall",
    "service:status": "node bin/herdr-link.mjs service status",
    "site": "node site/build.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.2",
    "discord.js": "^14.28.0",
    "effect": "^4.1.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.5",
    "@effect/vitest": "^4.1.2",
    "@types/node": "^24.19.2",
    "marked": "^18.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
